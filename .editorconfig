# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Go source code (must follow gofmt tab conventions)
[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

# Makefiles require tabs
[Makefile]
indent_style = tab

# YAML and JSON files
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Markdown files (allow trailing spaces for line breaks)
[*.md]
trim_trailing_whitespace = false
